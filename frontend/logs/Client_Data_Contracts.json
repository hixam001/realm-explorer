{
  "version": "1.0.0",
  "project": "Realm Explorer — Agentic Dungeon Crawler",
  "hackathon": "Google Antigravity Hackathon — Challenge 4",
  "base_url_emulator": "http://127.0.0.1:5001/demo-realm-explorer/us-central1/api/v1",
  "base_url_production": "https://us-central1-{PROJECT_ID}.cloudfunctions.net/api/v1",
  "contracts": {
    "POST /run": {
      "description": "Creates a new dungeon run and returns the initial run state.",
      "request": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "playerId": "test_player_01",
          "playerClass": "blade_dancer",
          "playStyle": "balanced"
        },
        "validation_rules": {
          "required_fields": ["playerId", "playerClass"],
          "playerClass_enum": ["blade_dancer", "ember_mage", "shadow_rogue"]
        }
      },
      "response_success": {
        "http_status": 200,
        "shape": {
          "success": true,
          "data": {
            "runId": "string — UUID v4",
            "playerId": "string",
            "playerClass": "string",
            "hp": "number — starting HP based on class",
            "maxHp": "number — same as hp at run start",
            "gold": 0,
            "currentFloor": 1,
            "playStyle": "string",
            "actionHistory": [],
            "eventLog": [],
            "inventory": [],
            "status": "active",
            "startedAt": "Firestore Timestamp"
          }
        },
        "example": {
          "success": true,
          "data": {
            "runId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "playerId": "test_player_01",
            "playerClass": "blade_dancer",
            "hp": 10,
            "maxHp": 10,
            "gold": 0,
            "currentFloor": 1,
            "playStyle": "balanced",
            "actionHistory": [],
            "eventLog": [],
            "inventory": [],
            "status": "active"
          }
        }
      },
      "response_error": {
        "http_status": 400,
        "shape": {
          "success": false,
          "error": "Missing required field: playerClass"
        }
      },
      "firestore_write": "runs/{runId}"
    },
    "POST /dm": {
      "description": "Calls the DM Agent to generate a unique floor encounter based on the current run state.",
      "request": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "playerId": "test_player_01",
          "floorNumber": 1,
          "playerClass": "blade_dancer",
          "hp": 10,
          "maxHp": 10,
          "playStyle": "balanced",
          "actionHistory": [],
          "eventLog": []
        },
        "validation_rules": {
          "required_fields": [
            "runId", "playerId", "floorNumber", "playerClass",
            "hp", "maxHp", "playStyle", "actionHistory", "eventLog"
          ],
          "floorNumber_range": "1–5",
          "playerClass_enum": ["blade_dancer", "ember_mage", "shadow_rogue"],
          "playStyle_enum": ["aggressive", "diplomatic", "cautious", "unpredictable", "balanced"]
        }
      },
      "response_success": {
        "http_status": 200,
        "shape": {
          "success": true,
          "data": {
            "encounter": {
              "encounterTitle": "string — short dramatic title",
              "narrativeText": "string — 2-3 sentences, second person",
              "enemyName": "string",
              "enemyType": "combat | negotiation | hybrid",
              "availableActions": ["string", "string", "string"],
              "difficultyWeight": "integer 1–5",
              "dmReasoning": "string — plain-English AI reasoning"
            }
          }
        },
        "example": {
          "success": true,
          "data": {
            "encounter": {
              "encounterTitle": "The Iron Gate",
              "narrativeText": "A massive stone construct blocks your descent. Its single eye pulses with ancient malice. The air around it hums with barely restrained force.",
              "enemyName": "Golem Sentinel",
              "enemyType": "combat",
              "availableActions": [
                "Strike the eye",
                "Seek a weakness in the joints",
                "Taunt it into overextending",
                "Retreat and reassess"
              ],
              "difficultyWeight": 3,
              "dmReasoning": "Player is on Floor 1 with full HP playing a Blade Dancer. Introduced a high-HP melee construct to test aggressive capabilities early and establish tone. DifficultyWeight 3 reflects standard entry-level challenge."
            }
          }
        }
      },
      "response_fallback": {
        "description": "Returned on any Gemini API failure. Frontend receives valid JSON and game continues.",
        "http_status": 200,
        "example": {
          "success": true,
          "data": {
            "encounter": {
              "encounterTitle": "The Dark Corridor",
              "narrativeText": "A goblin blocks your path, watching you with hungry eyes.",
              "enemyName": "Tunnel Goblin",
              "enemyType": "combat",
              "availableActions": ["Attack", "Negotiate", "Examine", "Flee"],
              "difficultyWeight": 2,
              "dmReasoning": "Fallback encounter triggered due to API error."
            }
          }
        }
      },
      "firestore_write": "runs/{runId}/encounters/floor_{floorNumber}"
    },
    "POST /rival": {
      "description": "Resolves a single player action against the enemy. Calls the Rival Agent and applies Fairness Referee validation.",
      "request": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "enemyName": "Golem Sentinel",
          "enemyType": "combat",
          "enemyHp": 10,
          "playerAction": "Strike the eye",
          "playerHp": 10,
          "playerClass": "blade_dancer",
          "combatTurns": 0,
          "floorNumber": 1
        },
        "validation_rules": {
          "required_fields": [
            "runId", "enemyName", "enemyType", "enemyHp",
            "playerAction", "playerHp", "playerClass", "combatTurns", "floorNumber"
          ],
          "fairness_rules": {
            "turn_0_max_player_damage": 3,
            "max_combat_turns_before_force_end": 6
          }
        }
      },
      "response_success": {
        "http_status": 200,
        "shape": {
          "success": true,
          "data": {
            "combat": {
              "outcomeText": "string — 1-3 sentence narrative",
              "playerHpDelta": "number — negative or zero",
              "enemyHpDelta": "number — negative or zero",
              "combatOver": "boolean",
              "playerWon": "boolean",
              "winQuality": "clean | close | messy",
              "rivalReasoning": "string — AI reasoning for enemy response"
            },
            "newHp": "number — player HP after delta applied",
            "newEnemyHp": "number — enemy HP after delta applied",
            "combatTurns": "number — incremented turn counter"
          }
        },
        "example": {
          "success": true,
          "data": {
            "combat": {
              "outcomeText": "Your blade finds the glowing eye socket. The Golem reels back, its movements stuttering and slow.",
              "playerHpDelta": -2,
              "enemyHpDelta": -4,
              "combatOver": false,
              "playerWon": false,
              "winQuality": "clean",
              "rivalReasoning": "Blade Dancer's precision strike hit a critical structural weakness. Rewarding the aggressive approach while dealing moderate retaliatory damage."
            },
            "newHp": 8,
            "newEnemyHp": 6,
            "combatTurns": 1
          }
        }
      },
      "response_fallback": {
        "http_status": 200,
        "example": {
          "success": true,
          "data": {
            "combat": {
              "outcomeText": "The enemy stumbles back.",
              "playerHpDelta": -1,
              "enemyHpDelta": -2,
              "combatOver": false,
              "playerWon": false,
              "winQuality": "messy",
              "rivalReasoning": "Fallback combat response."
            },
            "newHp": 9,
            "newEnemyHp": 8,
            "combatTurns": 1
          }
        }
      },
      "firestore_writes": [
        "runs/{runId}/combat/{id}",
        "runs/{runId} (hp, currentEnemyHp, combatTurns update)"
      ]
    },
    "POST /loot": {
      "description": "Generates a contextual item reward after a floor win, or 3 items in merchantMode for Floor 4.",
      "request": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "playerId": "test_player_01",
          "playerClass": "blade_dancer",
          "playStyle": "aggressive",
          "floorNumber": 1,
          "winQuality": "clean",
          "eventLog": ["Struck the eye of the Golem Sentinel"],
          "merchantMode": false
        },
        "validation_rules": {
          "required_fields": [
            "runId", "playerId", "playerClass", "playStyle",
            "floorNumber", "winQuality", "eventLog"
          ],
          "winQuality_enum": ["clean", "close", "messy"],
          "merchantMode_note": "Set to true on Floor 4 to receive items array of 3 items instead of single item"
        }
      },
      "response_success_single": {
        "http_status": 200,
        "shape": {
          "success": true,
          "data": {
            "item": {
              "itemName": "string",
              "itemEffect": "string",
              "styleNote": "string — why this suits the player's style",
              "flavorText": "string — atmospheric lore sentence",
              "itemType": "weapon | armor | ring | consumable"
            }
          }
        },
        "example": {
          "success": true,
          "data": {
            "item": {
              "itemName": "Sentinel's Cracked Eye",
              "itemEffect": "+2 to the first strike of each combat encounter",
              "styleNote": "A Blade Dancer who hunts critical weaknesses will find the eye's residual magic amplifies their precision.",
              "flavorText": "Even shattered, it sees the gap in every guard.",
              "itemType": "ring"
            }
          }
        }
      },
      "response_success_merchant": {
        "description": "Returned when merchantMode is true. Contains an array of 3 items.",
        "http_status": 200,
        "example": {
          "success": true,
          "data": {
            "items": [
              {
                "itemName": "Voidweave Cloak",
                "itemEffect": "-1 to all incoming damage for 3 turns",
                "styleNote": "Favours the Blade Dancer who needs breathing room between strikes.",
                "flavorText": "Woven from the shadows between heartbeats.",
                "itemType": "armor"
              },
              {
                "itemName": "Bloodletter's Edge",
                "itemEffect": "+3 to next strike, but take 1 damage yourself",
                "styleNote": "For the aggressive fighter who trades safety for dominance.",
                "flavorText": "It drinks from both sides of the blade.",
                "itemType": "weapon"
              },
              {
                "itemName": "Goblin Elixir",
                "itemEffect": "Restore 3 HP immediately",
                "styleNote": "A tactical reserve for when the Golem's fist connects harder than expected.",
                "flavorText": "Smells wrong. Works anyway.",
                "itemType": "consumable"
              }
            ]
          }
        }
      },
      "response_fallback": {
        "http_status": 200,
        "example": {
          "success": true,
          "data": {
            "item": {
              "itemName": "Worn Dagger",
              "itemEffect": "+1 to next attack",
              "styleNote": "A basic blade for any adventurer.",
              "flavorText": "Its edge is dull but its intent is clear.",
              "itemType": "weapon"
            }
          }
        }
      },
      "firestore_write": "runs/{runId}/loot/{id}"
    },
    "POST /recap": {
      "description": "Generates the end-of-run personalised narrative and updates the player profile in Firestore.",
      "request": {
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "playerId": "test_player_01",
          "playerClass": "blade_dancer",
          "finalHp": 4,
          "floorsCompleted": 2,
          "died": true,
          "gold": 15,
          "playStyle": "aggressive",
          "eventLog": [
            "Struck the eye of the Golem Sentinel on Floor 1",
            "Won Floor 1 with a clean victory",
            "Received the Sentinel's Cracked Eye",
            "Attempted to negotiate with the Shadow Broker on Floor 2",
            "Refused to sell information to the Shadow Broker",
            "Fell in combat against the Shadow Broker on Floor 2"
          ],
          "inventory": ["Sentinel's Cracked Eye"]
        },
        "validation_rules": {
          "required_fields": [
            "runId", "playerId", "playerClass", "finalHp",
            "floorsCompleted", "died", "gold", "playStyle", "eventLog", "inventory"
          ]
        }
      },
      "response_success": {
        "http_status": 200,
        "shape": {
          "success": true,
          "data": {
            "recap": {
              "narrativeText": "string — 3-5 sentences, second person, references eventLog events",
              "runTitle": "string — unique 2-5 word title for this specific run"
            }
          }
        },
        "example": {
          "success": true,
          "data": {
            "recap": {
              "narrativeText": "You descended as a Blade Dancer, hunger for the dark sharp as the steel in your hand. The Golem Sentinel fell to your precision, its cracked eye now a trophy at your finger. On the second floor, the Shadow Broker offered coin for secrets you refused to sell — a principle that cost you your life. The dungeon remembers the one who would not bend.",
              "runTitle": "The Principled Dancer"
            }
          }
        }
      },
      "response_fallback": {
        "http_status": 200,
        "example": {
          "success": true,
          "data": {
            "recap": {
              "narrativeText": "Your run ended in darkness, but the dungeon remembers your name.",
              "runTitle": "The Unknown Wanderer"
            }
          }
        }
      },
      "firestore_writes": [
        "players/{playerId}/recaps/{runId}",
        "players/{playerId} (runsCompleted++, allTimeTitles.arrayUnion, bestDepth update)"
      ]
    },
    "GET /health": {
      "description": "Health check endpoint. No authentication required.",
      "request": {
        "method": "GET"
      },
      "response_success": {
        "http_status": 200,
        "example": {
          "status": "ok",
          "timestamp": "2026-05-20T00:00:00.000Z"
        }
      }
    }
  },
  "zustand_store_shape": {
    "run": {
      "runId": "string | null",
      "playerId": "string | null",
      "playerClass": "string | null",
      "hp": "number | null",
      "maxHp": "number | null",
      "gold": "number | null",
      "currentFloor": "number | null",
      "playStyle": "string | null",
      "actionHistory": "string[]",
      "eventLog": "string[]",
      "inventory": "object[]",
      "status": "active | completed | died | null"
    },
    "currentEncounter": {
      "encounterTitle": "string | null",
      "narrativeText": "string | null",
      "enemyName": "string | null",
      "enemyType": "combat | negotiation | hybrid | null",
      "availableActions": "string[]",
      "difficultyWeight": "number | null",
      "dmReasoning": "string | null"
    },
    "isThinking": "boolean",
    "thinkingMessage": "string"
  },
  "encounter_screen_local_state": {
    "combatLog": "string[] — scrolling narrative history, seeded with encounter.narrativeText",
    "combatState": {
      "over": "boolean",
      "won": "boolean"
    },
    "localEnemyHp": "number — starts at 10, decremented by enemyHpDelta each turn",
    "currentTurn": "number — combatTurns counter, incremented by backend response"
  },
  "design_tokens": {
    "bg_deep": "#1A1A2E",
    "bg_card": "#2A2A4E",
    "accent": "#1D9E75",
    "danger": "#D85A30",
    "text_primary": "#FFFFFF",
    "text_secondary": "#B0B0C0",
    "border": "#3A3A6E",
    "muted": "#555555"
  },
  "character_classes": {
    "blade_dancer": {
      "startingHp": 10,
      "playStyleAffinity": "aggressive",
      "description": "A swift melee fighter who excels in rapid combos."
    },
    "ember_mage": {
      "startingHp": 8,
      "playStyleAffinity": "unpredictable",
      "description": "A tactical spellcaster who prefers high-risk, high-reward plays."
    },
    "shadow_rogue": {
      "startingHp": 9,
      "playStyleAffinity": "cautious",
      "description": "A careful infiltrator who uses deception and escape routes."
    }
  },
  "agent_error_codes": {
    "400": "Missing required field — validate middleware rejected the payload",
    "429": "Gemini API quota exceeded — backend returns hardcoded fallback",
    "503": "Gemini model unavailable — backend retries 3x with 5s delay, then returns hardcoded fallback",
    "500": "Unhandled backend error — errorHandler middleware returns structured error JSON"
  }
}
